# Compose/Portainer deployment values, not application configuration.
GITHUB_OWNER=outlain
IMAGE_TAG=latest
INTAKE_UID=3000
INTAKE_GID=3000
TI_UI_PUBLISH_IP=127.0.0.1
TI_UI_HOST_PORT=8095
MEDIA_NETWORK=shared_media_net

# Use LOCAL SSD/M.2 storage for SQLite, settings and backup/restore work.
TI_DATA_HOST_DIR=/opt/docker/torrent-intake/data
TI_LOCAL_STAGING_HOST_DIR=/mnt/bulk/docker/torrent-intake/staging
TI_MEDIA_HOST_DIR=/mnt/media
TI_EVENTS_HOST_DIR=/opt/docker/clamav-shared/events/torrent-intake
TI_QUARANTINE_HOST_DIR=/opt/docker/clamav-shared/quarantine/torrent-intake
TI_CLAMD_SOCKET_HOST_DIR=/opt/docker/clamav-shared/sockets/torrent-intake
CLAMAV_DEFS_HOST_DIR=/opt/docker/clamav-shared/defs

# Separate ClamD process: these remain in its container configuration.
CLAMD_MAX_SCAN_SIZE_MIB=2000
DEFINITIONS_MAX_AGE_SECONDS=172800

# Configure the application through Settings & Help or /app/data/settings.json.
# Merely adding a TI_* line HERE does not pass it into the container. To force
# an override, also add its environment mapping to the application service.
# Existing verbose stacks keep working; see README migration instructions.
# CONFIGURATION.md explains every deployment/application setting and required mount.
