# Core app
TI_DEBUG=false
TI_DATABASE_URL=sqlite:////app/data/torrent_intake.db

# qBittorrent connection
TI_QBT_HOST=http://qbittorrent:8080
TI_QBT_USERNAME=admin
TI_QBT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
TI_QBT_VERIFY_CERTIFICATE=false
TI_QBT_REQUEST_TIMEOUT_SECONDS=20
# Optional browser-facing qBittorrent WebUI URL. Use your host/IP URL, not a Docker-only service name.
TI_QBT_WEB_URL=http://localhost:8080

# Intake behavior and tagging
TI_INTAKE_CATEGORY=intake
TI_MANAGED_TAG=torrent_intake
TI_AUTO_CREATE_FINAL_CATEGORY=true

# Container path model (must stay aligned with README)
TI_LOCAL_STAGING_ROOT=/staging-local
TI_NAS_STAGING_ROOT=/downloads/torrent-intake/staging
TI_FINAL_PARENT_PREFIX=/downloads
# Optional comma-separated allowlist of additional final roots
# Example: TI_FINAL_PARENT_PREFIXES=/downloads,/library-2
TI_FINAL_PARENT_PREFIXES=

# Aggregate local overflow policy for local-preference jobs that are still
# under TI_LOCAL_MAX_GIB:
# - queue: pause local jobs until safe local space is available again
# - nas: move overflowing local jobs to NAS staging automatically
TI_LOCAL_OVERFLOW_POLICY=queue
# Hard per-torrent cutoff for local staging. Any local-preference torrent above
# this size moves to NAS staging automatically before aggregate space checks.
TI_LOCAL_MAX_GIB=200
# Keep this much free space on the local staging filesystem when calculating
# aggregate local reservations across active local jobs.
TI_LOCAL_FREE_SPACE_BUFFER_GIB=5

# Polling/event timing
TI_POLLING_INTERVAL_SECONDS=300
TI_COMPLETION_GRACE_SECONDS=15
TI_COMPLETION_EVENT_TOKEN=

# Malware scanner. Use clamd with the provided compose/Portainer sidecar.
TI_SCANNER_BACKEND=clamd
TI_CLAMD_SOCKET_PATH=/run/clamav/clamd.sock
# Increment this value after changing clamd limits or scan policy. Completed
# per-file checkpoints will then be invalidated once, while signature updates
# alone do not restart long scans.
TI_SCANNER_POLICY_VERSION=clamav-policy-v1
TI_SCANNER_MAX_FILE_MIB=2000
TI_SCANNER_HEALTH_CACHE_SECONDS=15
TI_SCANNER_CONNECT_TIMEOUT_SECONDS=5
TI_SCANNER_DEFINITIONS_WARN_HOURS=36
TI_SCANNER_DEFINITIONS_STALE_HOURS=72

# Command backend remains available for local diagnostics/backward compatibility.
TI_CLAMDSCAN_BINARY=clamscan
TI_CLAMDSCAN_ARGS=--infected --no-summary --alert-exceeds-max

# Restart-safe scan scheduler
# Two scans run by default. UI boosts may raise this only as high as
# TI_MAX_SCAN_SLOTS and reset automatically when the queue clears.
TI_MAX_CONCURRENT_SCANS=2
TI_MAX_SCAN_SLOTS=4
# Prevent two high-I/O torrents from scanning together.
TI_MAX_CONCURRENT_LARGE_SCANS=1
TI_LARGE_SCAN_GIB=100
TI_SCAN_SCHEDULER_INTERVAL_SECONDS=3
TI_SCAN_LEASE_SECONDS=90
TI_SCAN_HEARTBEAT_SECONDS=10
TI_SCAN_RETRY_BASE_SECONDS=30
TI_SCAN_MAX_FAILURES=3
# A running scan may yield to a prioritized/smaller job after this many files.
TI_SCAN_YIELD_AFTER_FILES=10

# Telegram alerts are only sent when malware is detected and deleted.
# Leave blank to disable alerts.
TI_TELEGRAM_BOT_TOKEN=
TI_TELEGRAM_CHAT_ID=
